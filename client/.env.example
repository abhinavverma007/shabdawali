# Where the game server lives. Baked in at build time (redeploy after changing).
# Local:      http://localhost:4000
# Production: your Render URL, which must be https, e.g. https://shabdawali-server.onrender.com
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Optional, for search engines and link previews (see README, "Link previews and search").
# Your public address; set it when you get your own domain.
# NEXT_PUBLIC_SITE_URL=https://www.shabdawali.in
# Verification codes from Google Search Console / Bing Webmaster Tools.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
